# ===========================================
# NairaRamp Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ===========================================
# Supabase Configuration
# ===========================================
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# Stellar Network Configuration
# ===========================================
# Network: TESTNET for development, PUBLIC for production
STELLAR_NETWORK=TESTNET

# Horizon API URL
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Master secret key for generating deposit addresses
# Generate a new keypair at https://laboratory.stellar.org/#account-creator?network=test
STELLAR_MASTER_SECRET_KEY=your-stellar-master-secret-key

# ===========================================
# Stellar Asset Issuers (Testnet)
# ===========================================
# USDC Testnet Issuer (Circle's testnet issuer)
USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# USDT Testnet Issuer
USDT_ASSET_ISSUER=GCQTGZQQ5G4PTM2GL7CDIFKUBIPEC52BROEZ2HZKJ4VPVUUGPCLQHHB6

# ===========================================
# Dojah KYC Configuration
# ===========================================
# Get these from your Dojah dashboard at https://app.dojah.io
DOJAH_APP_ID=your-dojah-app-id
DOJAH_API_KEY=your-dojah-api-key

# ===========================================
# Flutterwave Configuration
# ===========================================
# Get these from your Flutterwave dashboard at https://dashboard.flutterwave.com
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=your-flutterwave-encryption-key

# ===========================================
# Upstash Redis Configuration
# ===========================================
# Get these from your Upstash console at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ===========================================
# Security & Webhooks
# ===========================================
# Secret for signing/verifying webhooks (generate a random 32+ char string)
WEBHOOK_SECRET=your-webhook-secret-here

# NextAuth secret (if using NextAuth alongside Supabase)
NEXTAUTH_SECRET=your-nextauth-secret-here

# ===========================================
# Application URLs
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Feature Flags (optional)
# ===========================================
ENABLE_BVN_VERIFICATION=true
ENABLE_TESTNET_FAUCET=true
MIN_CONVERSION_AMOUNT=10
MAX_CONVERSION_AMOUNT=10000
CONVERSION_FEE_PERCENT=1.5
